{
  "name": "wsjtx-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:foundation": "playwright test --config playwright.foundation.config.ts"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.8"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
