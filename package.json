{
  "name": "wsjtx-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:foundation": "playwright test --config playwright.foundation.config.ts",
    "test:e2e:receiver": "playwright test --config playwright.receiver.config.ts",
    "test:e2e:station": "playwright test --config playwright.station.config.ts",
    "test:e2e:enrichment": "playwright test --config playwright.enrichment.config.ts",
    "test:e2e:wavelog": "playwright test --config playwright.wavelog.config.ts",
    "test:e2e:qso": "playwright test --config playwright.qso.config.ts",
    "test:e2e:mapping": "playwright test --config playwright.mapping.config.ts",
    "test:e2e:steps57": "playwright test --config playwright.steps57.config.ts"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "bootstrap": "^5.3.3",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.16.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/leaflet": "1.9.21",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.8"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
